HTTP_ADDR=:5050
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=1048576

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST_PORT=5433
POSTGRES_TIMEOUT=10s
POSTGRES_SSLMODE=disable

# DEBUG для локальной разработки; INFO или WARN на production
LOGGER_LEVEL=DEBUG

TIME_ZONE=UTC

JWT_SECRET=change-me-in-production
JWT_TTL=720h
JWT_ISSUER=todoapp

RATE_LIMIT_REGISTER_MAX=30
RATE_LIMIT_REGISTER_WINDOW=1m

# Локальный прямой доступ к todoapp (без nginx). На prod с nginx не используется.
TODOAPP_PORT_BINDING=127.0.0.1:5050:5050

# Production HTTPS (make deploy-prod + make cert-init)
# Домен должен указывать A-записью на IP сервера.
NGINX_DOMAIN=todo.example.com
CERTBOT_EMAIL=admin@example.com
