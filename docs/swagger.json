                },
                "completed_at": {
                    "description": "Дата завершения или null",
                    "type": "string"
                },
                "created_at": {
                    "description": "Дата создания",
                    "type": "string",
                    "example": "2026-07-08T12:00:00Z"
                },
                "description": {
                    "description": "Описание или null",
                    "type": "string",
                    "example": "2 литра"
                },
                "id": {
                    "description": "Идентификатор задачи",
                    "type": "integer",
                    "example": 1
                },
                "title": {
                    "description": "Заголовок",
                    "type": "string",
                    "example": "Купить молоко"
                },
                "version": {
                    "description": "Версия записи",
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "internal_features_tasks_transport_http.GetTaskResponse": {
            "type": "object",
            "properties": {
                "author_user_id": {
                    "description": "ID автора (из JWT)",
                    "type": "integer",
                    "example": 1
                },
                "completed": {
                    "description": "Выполнена ли задача",
                    "type": "boolean",
